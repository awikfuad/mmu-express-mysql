# Salin file ini menjadi `.env` lalu isi nilainya.
# JANGAN pernah commit file `.env` ke version control.

PORT=5000
NODE_ENV=production

# Database MySQL/MariaDB
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=mmu_a44

# Wajib: nilai acak kuat. Generate dengan:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# Password default untuk fitur reset password / akun santri baru
DEFAULT_RESET_PASSWORD=santri123

# CORS: '*' untuk terbuka (Flutter), atau daftar origin dipisah koma
# CORS_ORIGIN=https://admin.mmu44.app,http://localhost:5173
CORS_ORIGIN=*

# true bila server di belakang reverse proxy (ZimaOS, Nginx, Cloudflare)
TRUST_PROXY=true

# Google Sign-In (opsional, kosongkan bila tidak dipakai)
GOOGLE_CLIENT_ID=

# Cloudinary (opsional, kosongkan untuk simpan lokal ke volume uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
